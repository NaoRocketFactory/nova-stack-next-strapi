# ==========================================================
# 🔐 Application Security Keys (Change for production)
# ==========================================================
APP_KEYS=devKey1,devKey2,devKey3,devKey4
API_TOKEN_SALT=devApiTokenSalt
ADMIN_JWT_SECRET=devAdminJwt
ADMIN_AUTH_SECRET=devAdminSecret
TRANSFER_TOKEN_SALT=devTransferTokenSalt
JWT_SECRET=devJwtSecret

# ==========================================================
# 🗄️ Database Configuration (SQLite for development)
# ==========================================================
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db

# ==========================================================
# 🛠️ Optional: PostgreSQL for production
# ==========================================================
# DATABASE_CLIENT=postgres
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_NAME=strapi
# DATABASE_USERNAME=strapi
# DATABASE_PASSWORD=password

# ==========================================================
# 🖥️ Server Configuration
# ==========================================================
NODE_ENV=development
STRAPI_HOST=0.0.0.0
STRAPI_PORT=1337

# ==========================================================
# 🌐 Frontend Configuration
# ==========================================================
NEXT_PUBLIC_API_URL=http://localhost:1337
NEXT_PUBLIC_APP_URL=http://localhost:3000
