# ===========================================================
# 🌐 API Configuration – Strapi Backend
# ===========================================================

# URL of your Strapi instance (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:1338

# Public URL of the frontend (used for metadataBase, OpenGraph, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ===========================================================
# 🔐 Strapi API Token (server-side only, never expose client-side)
# ===========================================================
# Generate one in Strapi Admin → Settings → API Tokens
# Use "Read-only" type for public content
STRAPI_API_TOKEN=

# ============================================
# AI Configuration (optional)
# ============================================
# Provider: openai | anthropic | gemini | mistral
AI_PROVIDER=anthropic
# Your API key for the chosen provider
AI_API_KEY=your_api_key_here
# Optional: override default model — available models per provider:
# Anthropic: claude-sonnet-4-6 | claude-opus-5 | claude-haiku-4-5
# OpenAI: gpt-5.6-sol | gpt-5.6-terra | gpt-5.6-luna
# Google: gemini-2.0-flash | gemini-2.0-pro
# Mistral: mistral-large-latest | mistral-small-latest
# AI_MODEL=claude-sonnet-4-6
